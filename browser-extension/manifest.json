{
  "manifest_version": 3,
  "name": "مرصاد — جسر سهم المحلي",
  "version": "0.3.2",
  "description": "يربط تبويب مرصاد بتبويب سهم محليًا مع معاينة وتأكيد يدوي لكل أمر.",
  "permissions": ["tabs", "storage", "scripting"],
  "host_permissions": [
    "https://market-platform-5.onrender.com/*",
    "https://app.sahmcapital.com/*"
  ],
  "background": {"service_worker": "background.js"},
  "action": {"default_popup": "popup.html", "default_title": "مرصاد — سهم"},
  "content_scripts": [
    {
      "matches": ["https://market-platform-5.onrender.com/*"],
      "js": ["content-mirsad.js"],
      "run_at": "document_start"
    },
    {
      "matches": ["https://app.sahmcapital.com/*"],
      "js": ["content-sahm.js"],
      "css": ["styles.css"],
      "run_at": "document_idle"
    }
  ]
}
