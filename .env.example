# Copy to .env and fill in real values. Never commit .env (SRS 18 / NFR-9).

APP_ENV=development
API_KEY=change-me-to-a-long-random-string

# Local dev default is SQLite. Production must point to a managed Postgres DSN (SRS AD-5).
DATABASE_URL=sqlite:///./market_platform.db

# Market data (SRS 5.3, 9). yfinance needs no key and is dev-only, never production.
# To switch to Alpaca (primary provider, free IEX real-time tier): sign up for an Alpaca
# Paper Trading account, generate an API key/secret pair, set MARKET_DATA_PROVIDER=alpaca
# below and fill in the two keys — no code change needed (NFR-5).
# Finnhub is an alternative primary provider (owner decision 2026-07-17): set
# MARKET_DATA_PROVIDER=finnhub and fill in FINNHUB_API_KEY. Note: Finnhub's free tier
# restricts /stock/candle (OHLCV history) for US equities on many accounts.
MARKET_DATA_PROVIDER=yfinance
ALPACA_API_KEY=
ALPACA_API_SECRET=
FINNHUB_API_KEY=
SNIPE_OPTION_MAX_DTE=2
SNIPE_OPTION_MAX_PREMIUM=1.00
SNIPE_OPTION_MAX_SPREAD_PCT=0.15
SNIPE_OPTION_MIN_OPEN_INTEREST=100
SNIPE_OPTION_MIN_ABS_DELTA=0.30
SNIPE_OPTION_MAX_ABS_DELTA=0.65
SNIPE_OPTION_MAX_THETA_DECAY_PCT=40

# LLM adapter (CLAUDE.md rule 4). Switch provider by changing this single value.
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Options engine (SRS 11, M2-B) — approximate risk-free rate for Black-Scholes
RISK_FREE_RATE=0.045

# Self-audit scheduler (SRS 15, M3) — daily at 01:00 UTC. Disable for local dev if you
# don't want a background APScheduler thread running.
ENABLE_SELF_AUDIT_SCHEDULER=true

# Cost control (SRS 16.2)
DEFAULT_DAILY_CAP_USD=1.00
DEFAULT_MONTHLY_CAP_USD=20.00
COST_ANOMALY_CALLS_PER_MINUTE=10

# Site-wide access lock (Phase 5). LEAVE BLANK for local dev -> the whole site is open
# and no lock screen appears. Set it in production to require every visitor to enter this
# code (plus tick the disclaimer-consent box) on /lock before seeing any content. Extra
# per-person codes are created/revoked at /lock/admin (main-code holders only). The cookie
# is signed with API_KEY, so API_KEY MUST be a long random string in production.
ACCESS_CODE_MAIN=
SITE_LOCK_COOKIE_DAYS=30
